# Copia este archivo como .env y completa los valores. El .env no se sube al repositorio.

# Dominio público (en tu PC: localhost). Caddy obtiene el certificado HTTPS y arma los enlaces de los correos
DOMINIO=tu-subdominio.duckdns.org

# Base de datos
POSTGRES_DB=citas
POSTGRES_USER=citas
# openssl rand -hex 24
POSTGRES_PASSWORD=

# Clave de firma de los tokens: openssl rand -base64 32
JWT_SECRET=

# Correo SMTP con STARTTLS. Gmail: smtp.gmail.com, 587, la cuenta como usuario y remitente,
# y una contraseña de aplicación (requiere verificación en 2 pasos)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_REMITENTE=

# Primer administrador: se crea solo si no existe ninguno. Borra ADMIN_PASSWORD después del primer arranque
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_TIPO_DOCUMENTO=CC
ADMIN_DOCUMENTO=

# Demo del portafolio: recrea la clínica de ejemplo al arrancar y cada noche (borra todo menos los admins reales)
DEMO_HABILITADA=false
